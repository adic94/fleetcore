# Skopiuj do .env (plik .env NIE trafia do repozytorium). Wartości poniżej dotyczą WYŁĄCZNIE
# lokalnego docker-compose. Produkcyjne poświadczenia: magazyn sekretów (docs/08, „Sekrety").

NODE_ENV=development
PORT=3000

# Migracje i testy — właściciel bazy
DATABASE_URL=postgres://postgres:localdev@localhost:5432/fleetcore
# Aplikacja — rola fleetcore_app (NOBYPASSRLS). Hasło ustaw po migracji:
#   ALTER ROLE fleetcore_app PASSWORD 'apptest';
APP_DATABASE_URL=postgres://fleetcore_app:apptest@localhost:5432/fleetcore

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_DOCUMENTS=fleetcore-documents
OCR_SERVICE_URL=http://localhost:8000
MODULE_ENFORCEMENT=off
